  "components": {
    "chapter": {
      "label": "챕터 간지",
      "idea": "큰 흐름의 쉼표. 섹션 첫 2~3초, 파란 면/흰 면 번갈아."
    },
    "keyword": {
      "label": "대형 키워드",
