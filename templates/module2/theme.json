    },
    "ghost": {
      "label": "고스트 타이포",
      "idea": "배경에 옅은 큰 단어(5년·10년, AX). 슬라이드당 1회."
    },
    "stat": {
      "label": "큰 숫자 카운트업",
      "idea": "발화 순간 0에서 올라가 멈춤 + 증감 칩. 핵심 수치는 단독 장면.",
      "params": {
        "deltaScale": 0.3,
        "deltaMin": 48,
        "deltaWeight": 800
      }
    },
    "bars": {
      "label": "막대 차트",
      "idea": "전년 대비·목표 대비. 증가분(add)을 코랄로 얹으면 '얼마나 늘었나'가 보인다."
    },
    "line": {
      "label": "선 차트",
      "idea": "추세·전망(개념도면 '개념도' 표기).",
      "params": {
        "curve": 1
      },
      "paramLabels": {
        "curve": "곡선으로 부드럽게(1=켜기, 0=꺾은선)"
      }
    },
    "nodes": {
      "label": "노드 다이어그램",
      "idea": "개념·관계·흐름. 노드 3개 안팎, 말하는 순서대로 등장. 연결선은 회색 점선이 화살표 쪽으로 흐른다. 노드 icon(money·globe·robot·people·app·pc·market)·img + flipAt: 글자 원이 뒤집혀 움직이는 아이콘으로.",
      "params": {
        "labelGap": 66,
        "subGap": 64,
        "linkColor": "#8a94a6",
        "linkDash": 1,
        "linkFlow": 1.2,
        "arrowGap": 10,
        "flipDur": 16,
        "labelMin": 40,
        "labelWeight": 800,
        "iconColor": 1
      },
      "paramLabels": {
        "labelGap": "원 아래 라벨 간격 (원 가장자리→라벨 기준선, px)",
        "subGap": "라벨 → 설명 간격 (px)"
      }
    },
    "table": {
      "label": "표 + 행 하이라이트",
      "idea": "비교 3행 이하. 말하는 행으로 파란 막대 이동."
    },
    "cards": {
      "label": "카드 공개",
      "idea": "세 방향·일곱 전략 같은 지도. 말하는 카드만 밝게(focus).",
      "params": {
        "pad": 36,
        "flip": 1
      },
      "paramLabels": {
        "pad": "카드 안쪽 여백(px) — 제목이 이 안에 들어가게 자동 축소",
        "flip": "뒤집히며 등장(1=켜기, 0=끄기)"
      }
    },
    "arrow": {
      "label": "성장 화살표",
      "idea": "격차 확대·단계적 확대. 짧게 그려지고 라벨."
    },
    "banner": {
      "label": "배너 / 가로 띠",
      "idea": "섹션 결론 한 줄. 반전 문장은 화면을 비우고 코랄 가로 띠(rx 0, wipe)."
    },
    "broll": {
      "label": "실사 영상 자리",
      "idea": "감정 고점·비유에만. 영상이 없으면 자리표시로 나오고 나중에 교체."
    },
    "3d": {
      "label": "3D 장면",
      "idea": "지리(지구본)·입체 막대·층 쌓기. THREE_KIT."
    },
    "zoomReveal": {
      "label": "사진 줌아웃 공개",
      "idea": "챕터 시작·장소 소개: 크게 당겨진 흐린 사진이 제자리로 빠지며 초점이 맞고, 한 줄 캡션이 올라온다. 건물 전경·사무실·행사장에."
    },
    "split": {
      "label": "두 화면 맞붙기",
      "idea": "둘을 나란히: 국내↔해외, 은행↔보험, 작년↔올해. 양쪽에서 밀려와 가운데서 만나고 VS 원이 튄다."
    },
    "gallery": {
      "label": "사진 그리드",
      "idea": "여러 장면을 한눈에: 임직원 감사·현장 모음. 칸마다 차례로 커지며, highlight로 말하는 칸만 밝게."
    },
    "compare": {
      "label": "전·후 비교 슬라이더",
      "idea": "변화 보여주기: 리뉴얼 전후·화면 개선 전후. 구분선이 움직이며 '후'가 드러난다."
    },
    "stack": {
      "label": "사진 쌓기",
      "idea": "시간 흐름·추억: 사진이 위에서 떨어지며 겹겹이. 마지막 사진(맨 위)에 라벨."
    },
    "bars3d": {
      "label": "3D 쿼터뷰 막대",
      "idea": "정면 2D 막대로 시작 → 카메라가 쿼터뷰로 돌며 입체가 되고, 막대가 차례로 위로 솟는다. 실적·성장 결정타 1회. (bars3d)",
      "params": {
        "rx": -22,
        "ry": -32,
        "zoom": 0.8,
        "depth": 0.8,
        "perspective": 3600
      }
    },
    "cards3d": {
      "label": "3D 뒤집기 카드",
      "idea": "카드 뒷면(색+번호)이 보이다가 정면 3등분 그대로 양옆 카드만 안쪽으로 살짝 꺾이고(병풍, 가로선 평행) 차례로 뒤집혀 앞면 공개 → 다시 정면. mode:\"tilt\"면 예전처럼 무대 전체가 비스듬히. (cards3d)",
      "params": {
        "rx": 16,
        "ry": -20,
        "zoom": 0.86,
        "perspective": 3600,
        "mode": "fold",
        "fold": 18,
        "foldZoom": 0.9
      }
    },
    "rankRise": {
      "label": "순위 상승",
      "idea": "1·2·3위 입체 막대 + 1위가 더 솟고, 붉은 리본 화살표가 물결치며 오른쪽 위로. 배경도 오른쪽 위로 흐른다. '격차 확대' 결정타. (rankRise)"
    },
    "rings": {
      "label": "과녁 고리",
      "idea": "가운데 영역에서 한 겹씩 넓어지는 입체 원판, 라벨은 고리 위. '단계적 확대'. (rings)"
    },
    "panels3": {
      "label": "3분할 빗면 패널",
      "idea": "화면을 비스듬히 셋으로 — 패널마다 아이콘이 움직인다. 원 3개가 반복될 때 대신. (panels3)"
    },
    "stackBuild": {
      "label": "블록 쌓기 → 지도",
      "idea": "아이콘이 블록이 되어 빈자리에 끼워지고, 다 쌓이면 미국 지도가 파랗게 물든다. 빌드업. (stackBuild)"
    },
    "wordSwarm": {
      "label": "글자 폭증 비행",
      "idea": "가운데 한 단어(역량)가 100개로 불어나 공간에 흩어지고, 카메라가 휘어지며 사이를 날아 지나간 뒤 화면이 비면 다음 화두가 딱. 화두 전환용. (wordSwarm)",
      "params": {
        "count": 100,
        "size": 120
      }
    },
    "horizon": {
      "label": "경계 넘어 수평선·태양",
